#!/usr/bin/env python3
"""bf — bug triage CLI.

Re-execs into agent/.venv if one exists, so the skill works from any harness
without the host having to activate anything first.
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
VENV = os.path.join(HERE, ".venv")
VENV_PY = os.path.join(VENV, "bin", "python3")

# Compare prefixes, not interpreter paths: a venv's bin/python3 is a symlink back
# to the base interpreter, so realpath() equality would always skip the re-exec.
if os.path.exists(VENV_PY) and os.path.normpath(sys.prefix) != os.path.normpath(VENV):
    os.execv(VENV_PY, [VENV_PY, os.path.abspath(__file__), *sys.argv[1:]])

sys.path.insert(0, HERE)

try:
    from bugforge_agent.cli import main
except ImportError as exc:  # noqa: BLE001
    sys.exit(
        f"bf: missing dependency ({exc}).\n"
        f"    python3 -m venv {HERE}/.venv && "
        f"{HERE}/.venv/bin/pip install -r {HERE}/requirements.txt"
    )

if __name__ == "__main__":
    raise SystemExit(main())
