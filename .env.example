# ─────────────────────────────────────────────────────────────────────────────
#  BugForge environment
#  Copy to .env. Every value below is also hard-defaulted in docker-compose.yml,
#  so the stack runs with no .env at all. This file documents the contract.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=bugforge
POSTGRES_USER=bugforge
POSTGRES_PASSWORD=bugforge
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Used by api, collector, supportdesk and every script that talks to the db.
DATABASE_URL=postgresql+psycopg2://bugforge:bugforge@db:5432/bugforge

# Same database as seen from the host (pytest, psql, ad-hoc scripts).
DATABASE_URL_HOST=postgresql+psycopg2://bugforge:bugforge@localhost:5432/bugforge

# Schemas
SHOP_SCHEMA=shop
TELEMETRY_SCHEMA=telemetry

# --- Service addresses (container network) -----------------------------------
API_INTERNAL_URL=http://api:8000
COLLECTOR_URL=http://collector:8001
WEB_INTERNAL_URL=http://web:3000
SUPPORTDESK_INTERNAL_URL=http://supportdesk:3001

# --- Service addresses (browser / host) --------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:8001
WEB_ORIGIN=http://localhost:3000

# --- Auth --------------------------------------------------------------------
SESSION_COOKIE_NAME=sf_session
SESSION_TTL_HOURS=720
SEED_PASSWORD=password123

# --- Telemetry ---------------------------------------------------------------
TELEMETRY_ENABLED=1
TELEMETRY_BATCH_MS=2000
TELEMETRY_QUEUE_MAX=10000

# --- Misc --------------------------------------------------------------------
TZ=UTC
PYTHONUNBUFFERED=1
NEXT_TELEMETRY_DISABLED=1
